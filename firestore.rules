rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own document and nested subcollections (tasks, workspaces, categories, etc.)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public user profiles lookup (for collaboration / user search)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Teams collection and all nested subcollections (members, etc.)
    match /teams/{teamId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /teams/{teamId} {
      allow read, write: if request.auth != null;
    }
    
    // Example for a public read, authenticated write collection (like posts)
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
